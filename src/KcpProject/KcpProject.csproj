    <RootNamespace>KcpProject</RootNamespace>
    <AssemblyName>KcpProject</AssemblyName>
    <Description>KCP(신뢰성 UDP ARQ 프로토콜) C# 코어 구현. 외부 의존성 0.</Description>
  </PropertyGroup>

  <!-- 테스트에서 내부 상태(Segment 큐, RingBuffer 등)를 직접 검증한다. -->
  <ItemGroup>
    <InternalsVisibleTo Include="KcpProject.Tests" />
    <InternalsVisibleTo Include="KcpProject.SimTests" />
    <InternalsVisibleTo Include="KcpProject.Transport" />
    <InternalsVisibleTo Include="KcpProject.Benchmarks" />
  </ItemGroup>

</Project>
