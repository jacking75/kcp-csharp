<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net8.0</TargetFrameworks>
    <RootNamespace>KcpCSharpR1.Transport</RootNamespace>
    <AssemblyName>KcpCSharpR1.Transport</AssemblyName>
    <Description>KcpCSharpR1 전송 계층: 소켓 I/O, 세션 수명(핸드셰이크/keepalive/종료), 프레이밍.</Description>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>KcpCSharpR1.Transport</PackageId>
    <PackageTags>kcp;udp;networking;game;arq;reliable-udp;monogame</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KcpCSharpR1\KcpCSharpR1.csproj" />
  </ItemGroup>

  <!--
    M-1/M-2 의 스레드 경계 큐에 System.Threading.Channels 를 쓴다.
    net8.0 에는 BCL 에 들어 있어 참조가 필요 없고, netstandard2.1 에서만 패키지로 가져온다.
    코어(KcpCSharpR1)는 여전히 의존성 0 이다.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="System.Threading.Channels" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KcpCSharpR1.Tests" />
    <InternalsVisibleTo Include="KcpCSharpR1.SimTests" />
    <InternalsVisibleTo Include="KcpCSharpR1.Benchmarks" />
  </ItemGroup>

</Project>
