<Project>

  <!-- 전 프로젝트 공통 속성. 개별 csproj 는 이 값을 덮어쓰지 않는 것을 원칙으로 한다. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ImplicitUsings>disable</ImplicitUsings>
    <Authors>jacking75</Authors>
    <Product>KcpCSharpR1</Product>
    <Copyright>Copyright (c) jacking75</Copyright>
    <NeutralLanguage>ko-KR</NeutralLanguage>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-minimum</AnalysisLevel>
    <!-- CA1510(ArgumentNullException.ThrowIfNull)은 .NET 6+ 전용이라 netstandard2.1 타깃에서 쓸 수 없다. -->
    <!-- CA1513(ObjectDisposedException.ThrowIf) 도 마찬가지로 .NET 7+ 전용이다. -->
    <NoWarn>$(NoWarn);CA1510;CA1513</NoWarn>

    <!-- NuGet 패키징 공통 속성(P8-1). 패키지로 낼 프로젝트만 개별 csproj 에서 IsPackable 을 true 로 덮어쓴다. -->
    <IsPackable>false</IsPackable>
    <Version>0.11.0</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/jacking75/kcp-csharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jacking75/kcp-csharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

</Project>
